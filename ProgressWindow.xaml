
<Window x:Class="CsCompressor.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing your video!"
        Height="220" Width="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        Foreground="White">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PercentageText"
                   Text="0%"
                   FontSize="60"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="Black"
                   VerticalAlignment="Center"/>

        <ProgressBar x:Name="Progress"
                     Grid.Row="1"
                     Height="12"
                     Minimum="0"
                     Maximum="100"
                     Value="0"
                     Margin="0,15,0,0"/>

        <Button x:Name="AbortButton"
                Grid.Row="2"
                Content="Abort"
                Height="35"
                Margin="0,15,0,0"
                Background="#333333"
                Foreground="White"
                BorderBrush="#555555"
                Click="Abort"/>
    </Grid>
</Window>
