<Window x:Class="VideoProcessor.VideoProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS Compressor"
        Height="780"
        Width="1050"
        MinHeight="650"
        MinWidth="850"
        Icon="frameworks/CSCompressor.ico"
        Background="#F3F4F6"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="12,3"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="FieldTitle">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#374151"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="CS Compressor"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="#111827"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">

                    <GroupBox Header="Files">
                        <StackPanel>
                            <TextBlock Text="Input file"
                                       Style="{StaticResource FieldTitle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="pathTB"
                                         IsReadOnly="True"
                                         Margin="0,4,8,4"/>

                                <Button x:Name="BrowseButton"
                                        Grid.Column="1"
                                        Content="Browse..."
                                        Click="InputBrowse"
                                        Margin="0,4,0,4"/>
                            </Grid>

                            <TextBlock x:Name="MediaInfoTextBlock"
                                       Text="No media loaded"
                                       FontSize="11"
                                       Foreground="#6B7280"
                                       Margin="0,0,0,10"/>

                            <TextBlock Text="Output file"
                                       Style="{StaticResource FieldTitle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="OutputPathTB"
                                         IsReadOnly="True"
                                         Margin="0,4,8,10"/>

                                <Button x:Name="OutputBrowseButton"
                                        Grid.Column="1"
                                        Content="Browse..."
                                        Click="OutputBrowse"
                                        Margin="0,4,0,10"/>
                            </Grid>

                            <TextBlock Text="Output format"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="OutputFormatCB" SelectionChanged="OutputFormatChanged">
                                <ComboBoxItem Content="MP4"/>
                                <ComboBoxItem Content="MOV"/>
                                <ComboBoxItem Content="GIF"/>
                                <ComboBoxItem Content="MKV"/>
                                <ComboBoxItem Content="WebM"/>
                                <ComboBoxItem Content="OGG"/>
                                <ComboBoxItem Content="AAC"/>
                                <ComboBoxItem Content="WAV"/>
                                <ComboBoxItem Content="FLAC"/>
                                <ComboBoxItem Content="MP3"/>
                            </ComboBox>

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Video Encoding">
                        <StackPanel>

                            <TextBlock Text="Video encoder"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="VideoEncoderCB"
                                      SelectionChanged="VideoEncoderChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="-"/>
                            </ComboBox>

                            <TextBlock Text="Rate control"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="VideoRateControlCB" SelectedIndex="0" SelectionChanged="RateControlChanged">
                                <ComboBoxItem Content="CBR"/>
                                <ComboBoxItem Content="VBR"/>
                                <ComboBoxItem Content="CQP"/>
                                <ComboBoxItem Content="CQ"/>
                            </ComboBox>

                            <TextBlock Text="Video bitrate"
                                       x:Name="VideoBitrateTitle"
                                       Style="{StaticResource FieldTitle}"/>
                            <TextBlock Text="M, K suffix ex. 10M = 10 Mb/s, 128K = 128 Kb/s"
                                       FontSize="11"
                                       Foreground="#6B7280"/>
                            <TextBox x:Name="VideoBitrateTB"/>

                            <TextBlock Text="CQ / CQP constant (Quality: lower is better)"
                                       Style="{StaticResource FieldTitle}"/>

                            <TextBox x:Name="CQTB"/>

                            <TextBlock Text="Minimum video bitrate"
                                       Style="{StaticResource FieldTitle}"/>

                            <TextBox x:Name="MinimumVideoBitrateTB"/>

                            <TextBlock Text="Maximum video bitrate"
                                       Style="{StaticResource FieldTitle}"/>

                            <TextBox x:Name="MaximumVideoBitrateTB"/>

                            <TextBlock Text="Buffer size"
                                       Style="{StaticResource FieldTitle}"/>

                            <TextBox x:Name="BufferSizeTB"/>

                            <TextBlock Text="Encoding speed"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="VideoEncodingSpeedCB"/>

                            <TextBlock Text="Encoding effort (CPU-Used)"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="CPUUsedCB">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="6"/>
                                <ComboBoxItem Content="7"/>
                            </ComboBox>

                        </StackPanel>
                    </GroupBox>

                </StackPanel>

                <StackPanel Grid.Column="2">

                    <GroupBox Header="Video Filters">
                        <StackPanel>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Resolution (Width × Height)"
                                           Style="{StaticResource FieldTitle}"/>
                                <Button Grid.Column="1"
                                        Content="Match Source"
                                        Height="22"
                                        Padding="6,1"
                                        FontSize="11"
                                        Click="MatchSourceResolution"
                                        Margin="0"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="WidthTB"/>

                                <TextBlock Grid.Column="1"
                                           Text="×"
                                           VerticalAlignment="Center"
                                           Margin="8,0"/>

                                <TextBox x:Name="HeightTB"
                                         Grid.Column="2"/>
                            </Grid>

                            <TextBlock Text="Framerate (fps)"
                                       Style="{StaticResource FieldTitle}"/>

                            <TextBox x:Name="FramerateTB"/>

                            <TextBlock Text="Scaling algorithm"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="VideoScalingFlagCB" SelectedIndex="4">
                                <ComboBoxItem Content="fast_bilinear"/>
                                <ComboBoxItem Content="bilinear"/>
                                <ComboBoxItem Content="bicubic"/>
                                <ComboBoxItem Content="neighbor"/>
                                <ComboBoxItem Content="area"/>
                                <ComboBoxItem Content="bicublin"/>
                                <ComboBoxItem Content="gauss"/>
                                <ComboBoxItem Content="sinc"/>
                                <ComboBoxItem Content="lanczos"/>
                                <ComboBoxItem Content="spline"/>
                            </ComboBox>

                            <CheckBox x:Name="AccurateColorGifCB"
                                      Content="Accurate GIF color (GIF format only)"
                                      IsEnabled="false"
                                      Margin="0,5,0,8"/>

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Audio Encoding">
                        <StackPanel>

                            <TextBlock Text="Audio encoder"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="AudioEncoderCB">
                                <ComboBoxItem Content="No encoding"/>
                            </ComboBox>

                            <TextBlock Text="Audio bitrate"
                                       Style="{StaticResource FieldTitle}"/>

                            <TextBox x:Name="AudioBitrateTB" Text="128k"/>

                            <TextBlock Text="Audio channels"
                                       Style="{StaticResource FieldTitle}"/>

                            <ComboBox x:Name="AudioChannelAmountCB" SelectedIndex="1">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="2"/>
                            </ComboBox>

                            <CheckBox x:Name="DisableAudioCB"
                                      Content="Disable audio"
                                      Margin="0,5,0,8"/>

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Trims">
                        <StackPanel>

                            <TextBlock Text="Start time (HH:MM:SS)"
                                       Style="{StaticResource FieldTitle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="StartHourTB" Text="00"/>
                                <TextBlock Grid.Column="1" Text=":"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>

                                <TextBox x:Name="StartMinuteTB" Text="00"
                                         Grid.Column="2"/>
                                <TextBlock Grid.Column="3" Text=":"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>

                                <TextBox x:Name="StartSecondTB" Text="00"
                                         Grid.Column="4"/>
                            </Grid>

                            <TextBlock Text="End time (HH:MM:SS, leave as -- to keep full length)"
                                       Style="{StaticResource FieldTitle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="EndHourTB" Text="--"/>
                                <TextBlock Grid.Column="1" Text=":"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>

                                <TextBox x:Name="EndMinuteTB" Text="--"
                                         Grid.Column="2"/>
                                <TextBlock Grid.Column="3" Text=":"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>

                                <TextBox x:Name="EndSecondTB" Text="--"
                                         Grid.Column="4"/>
                            </Grid>

                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Other Options">
                        <StackPanel>

                            <CheckBox x:Name="CopyMetaDataCB"
                                      Content="Copy metadata"
                                      IsChecked="True"
                                      Margin="0,5,0,8"/>

                            <CheckBox x:Name="EnableLog"
                                      Content="Show FFmpeg output log"
                                      Margin="0,5,0,8"/>

                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Log Output Viewer (collapsible/expandable when enabled) -->
        <Expander Grid.Row="2"
                  x:Name="LogExpander"
                  Header="FFmpeg Log Output"
                  Visibility="Collapsed"
                  Margin="0,8,0,0">
            <TextBox x:Name="LogTextBox"
                     Height="100"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas, monospace"
                     FontSize="11"
                     Background="#1F2937"
                     Foreground="#F9FAFB"/>
        </Expander>

        <!-- Bottom action bar -->
        <Border Grid.Row="3"
                BorderBrush="#D1D5DB"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,8,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <ProgressBar x:Name="CompressionProgressBar"
                                 Height="14"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,0,0,4"/>
                    <TextBlock x:Name="StatusTextBlock"
                               Text="Ready to compress"
                               FontSize="12"
                               Foreground="#4B5563"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton"
                            Content="Cancel"
                            Height="40"
                            Width="90"
                            IsEnabled="False"
                            Click="CancelCompression"
                            Margin="0,0,10,0"/>

                    <Button x:Name="Go"
                            Content="Compress"
                            Height="40"
                            Width="130"
                            FontSize="15"
                            FontWeight="Bold"
                            Background="#1E40AF"
                            Foreground="White"
                            BorderThickness="0"
                            Click="StartCompression"
                            Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
