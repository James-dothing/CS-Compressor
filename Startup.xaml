
<Window
        x:Class="CsCompressor.Startup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CS Compressor"
        Height="450"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Icon="frameworks/CSCompressor.ico">

        
    <Grid>
        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="500">

            <TextBlock Text="CS compressor"
                       FontSize="32"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,35"/>

            <TextBox x:Name="pathTB"
                     Height="35"
                     IsReadOnly="False"
                     VerticalContentAlignment="Center"
                     Margin="0,0,0,10"/>

            <Button Content="Browse..."
                    Height="35"
                    Click="SelectFile"
                    Margin="0,0,0,20"/>

            <Button Content="Go!"
                    Height="45"
                    FontSize="16"
                    FontWeight="Bold"
                    Click="Go"/>

        </StackPanel>
    </Grid>
</Window>
