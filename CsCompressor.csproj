
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>frameworks\CSCompressor.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefaultItemExcludes>$(DefaultItemExcludes);CsCompressor.Core/**;tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="frameworks\CSCompressor.ico" />
    <EmbeddedResource Include="frameworks\7za.exe" />
    <EmbeddedResource Include="frameworks\ffmpeg.7z" />
    <EmbeddedResource Include="frameworks\ffprobe.7z" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CsCompressor.Core\CsCompressor.Core.csproj" />
  </ItemGroup>

</Project>
